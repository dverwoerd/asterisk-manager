ANTHROPIC_API_KEY=sk-ant-...        # verplicht
AI_COMPANY=Pantronic
AI_MODEL=claude-haiku-5-5           # snel; claude-sonnet-5-5 is slimmer maar trager
AI_WHISPER_MODEL=small              # tiny/base = sneller, medium = nauwkeuriger
AI_VOICE=/opt/piper/voices/nl_NL-ronnie-medium.onnx
AI_SPEED=0.92                       # lager = sneller praten
AI_MAX_TURNS=12
AI_MAX_SECONDS=300
AI_SILENCE=0.7                      # seconden stilte voordat de assistent antwoordt
